{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Notibar - WordPress Notification Bar",
		"description": "Try Notibar: multiple notification bars with a live-preview Customizer editor.",
		"author": "Ninja Team",
		"categories": [ "Notification", "Marketing" ]
	},
	"landingPage": "/wp-admin/customize.php?autofocus[section]=njt_nofi_bars_section",
	"preferredVersions": {
		"php": "8.2",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "login",
			"username": "admin",
			"password": "password"
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "notibar"
			},
			"options": {
				"activate": true
			}
		}
	]
}
